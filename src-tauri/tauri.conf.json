{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbe Imagem Studio",
  "version": "14.5.0",
  "identifier": "br.orbe.imagemstudio",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "npm run build:updater",
    "beforeBuildCommand": "npm run build:updater"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbe Imagem Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: asset:; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../ai/remove_background.py": "ai/remove_background.py",
      "../ai/requirements-ai.txt": "ai/requirements-ai.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: B2FFE3AF1ACB241F\nRWQfJMsar+P/su39PnQWA+SG60ZBNjT9tgzqeIgFlqpm5jNU2qLsSVZv\n",
      "endpoints": [
  "https://github.com/DAVIFS22/orbe-imagem-studio/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
